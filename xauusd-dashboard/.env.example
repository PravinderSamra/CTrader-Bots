# CTrader MCP — remote endpoint (https://mcp.ctrader.com/trading/mcp)
# VITE_ prefix exposes to the browser bundle. This token is embedded in the built JS.
# Regenerate if this repo ever goes public.
VITE_CTRADER_MCP_URL=https://mcp.ctrader.com/trading/mcp
VITE_CTRADER_MCP_TOKEN=your_ctrader_bearer_token_here

# Finnhub — free tier, 60 calls/min. Get key at finnhub.io
VITE_FINNHUB_KEY=your_finnhub_api_key_here

# Anthropic — for AI briefing generation (client-side on demand)
# WARNING: This key is visible in the compiled JS bundle. Only use on a private repo.
VITE_ANTHROPIC_KEY=your_anthropic_api_key_here

# FRED API key — used by GitHub Action only (never exposed to browser)
FRED_API_KEY=your_fred_api_key_here

# Pravzella (trade journal tab) — Supabase project.
# The anon key is designed to be public (see PRAVZELLA.md "Auth model") — access
# control is Row Level Security + a real login, not secrecy of this key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side only (used by scripts/sync-trades.ts in GitHub Actions, never exposed
# to the browser) — bypasses Row Level Security, so treat as a real secret.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_USER_ID=your_supabase_auth_user_uuid_here
