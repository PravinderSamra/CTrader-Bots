# Twelve Data API key — free tier at twelvedata.com (800 credits/day)
TWELVE_DATA_API_KEY=your_api_key_here

# ── cTrader MCP connection (FTMO account — LOCAL AGENT ONLY) ──────────────────
# This is a SEPARATE connection from the Remote Agent's cTrader MCP (which uses
# a different Pepperstone account). Get your own MCP endpoint URL for your
# FTMO cTrader account and put it ONLY in your local .env.
#
# SECURITY: .env is gitignored — never commit it, never paste these values
# into chat, issues, PRs, or any other file that gets pushed to GitHub.
#
# CTRADER_MCP_TOKEN is OPTIONAL — leave blank for a local cTrader desktop
# MCP server (e.g. http://127.0.0.1:<port>/mcp/) that authenticates via the
# desktop app session and doesn't issue a bearer token.
#
# Leave CTRADER_MCP_URL blank to skip cTrader entirely — the agent falls back
# to Twelve Data / Yahoo / OKX for all instruments.
CTRADER_MCP_URL=
CTRADER_MCP_TOKEN=

# cTrader Open API credentials — from Pepperstone + cTrader app registration
# Required for Phase 2: direct cTrader data fetching and trade execution
# Leave blank until ready to set up (system falls back to Yahoo/Twelve Data)
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=
CTRADER_HOST=live.ctraderapi.com
