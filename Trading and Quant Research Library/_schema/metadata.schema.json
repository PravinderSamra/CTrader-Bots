{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/trading-quant-library/metadata.schema.json",
  "title": "Strategy metadata",
  "type": "object",
  "required": [
    "id",
    "title",
    "slug",
    "strategy_type",
    "asset_classes",
    "complexity_score",
    "execution_type",
    "requires_machine_learning",
    "evidence_grade",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "strategy_type": {
      "type": "string",
      "enum": [
        "statistical-arbitrage",
        "trend-following",
        "volatility-and-variance",
        "market-making-microstructure",
        "cross-sectional-factors",
        "event-and-flow-driven",
        "carry-and-term-structure",
        "machine-learning-alpha",
        "execution-and-cost"
      ]
    },
    "asset_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["equities", "etfs", "futures", "fx", "commodities", "fixed-income", "options", "crypto", "indices"]
      }
    },
    "complexity_score": { "type": "integer", "minimum": 1, "maximum": 10 },
    "execution_type": { "type": "string", "enum": ["Manual", "Mechanical", "Quant"] },
    "requires_machine_learning": { "type": "boolean" },
    "evidence_grade": {
      "type": "string",
      "enum": ["verified-primary", "verified-secondary", "unverified", "rejected-case-study"]
    },
    "holding_period": { "type": "string" },
    "signal_frequency": { "type": "string" },
    "directionality": { "type": "string", "enum": ["long-only", "long-short", "market-neutral", "two-sided-quoting"] },
    "data_requirements": { "type": "array", "items": { "type": "string" } },
    "capacity": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
    "decay_status": {
      "type": "string",
      "enum": ["intact", "partially-decayed", "substantially-decayed", "unknown"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "citation"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "enum": ["paper", "repository", "dataset", "book", "article"] },
          "citation": { "type": "string" },
          "url": { "type": "string" },
          "verified_in_session": { "type": "boolean" }
        }
      }
    },
    "related_strategies": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "ingested_at": { "type": "string", "format": "date" }
  }
}
